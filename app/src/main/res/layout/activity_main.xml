<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Elemento Central: El Anillo Único -->
    <ImageView
        android:id="@+id/ivAnillo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:contentDescription="@string/anillo"
        android:src="@drawable/foto_anillo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="spread" />

    <!-- Facciones en Órbita Circular (Logos) -->
    <ImageView
        android:id="@+id/ivGondor"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:contentDescription="@string/gondor"
        android:src="@drawable/foto_gondor"
        app:layout_constraintCircle="@+id/ivAnillo"
        app:layout_constraintCircleRadius="140dp"
        app:layout_constraintCircleAngle="0" />

    <ImageView
        android:id="@+id/ivRohan"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:contentDescription="@string/rohan"
        android:src="@drawable/foto_rohan"
        app:layout_constraintCircle="@+id/ivAnillo"
        app:layout_constraintCircleRadius="140dp"
        app:layout_constraintCircleAngle="120" />

    <ImageView
        android:id="@+id/ivMordor"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:contentDescription="@string/mordor"
        android:src="@drawable/foto_sauron"
        app:layout_constraintCircle="@+id/ivAnillo"
        app:layout_constraintCircleRadius="140dp"
        app:layout_constraintCircleAngle="240" />

</androidx.constraintlayout.widget.ConstraintLayout>