<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Guia para dividir en dos columnas  -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Columna Izquierda: El Anillo -->
    <ImageView
        android:id="@+id/ivAnillo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:contentDescription="@string/anillo"
        android:src="@drawable/foto_anillo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline" />

    <!-- Columna Derecha: Facciones agrupadas -->
    <Button
        android:id="@+id/btnGondor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gondor"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnRohan"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <Button
        android:id="@+id/btnRohan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rohan"
        app:layout_constraintTop_toBottomOf="@+id/btnGondor"
        app:layout_constraintBottom_toTopOf="@+id/btnMordor"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnMordor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mordor"
        app:layout_constraintTop_toBottomOf="@+id/btnRohan"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>